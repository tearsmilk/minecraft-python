diff --git a/launcher/src/honoka.rs b/launcher/src/honoka.rs
new file mode 100644
index 0000000000000000000000000000000000000000..804cf4b992ec3515bfc32305448989e492f85657
--- /dev/null
+++ b/launcher/src/honoka.rs
@@ -0,0 +1,42 @@
+//! Honoka: everything this fork of the Horizon launcher changes is named here, so the patch over
+//! Horizon stays a handful of one-line call sites (see the Honoka repository's `patches/`).
+//!
+//! Honoka is the launcher of the Hoka server: one Play button that starts the game straight on
+//! the server. The game builds themselves are still Horizon's, downloaded from horizon-rust/horizon
+//! and checked against Horizon's signatures as before.
+
+/// The name shown in the window's title.
+pub const APP_NAME: &str = "Honoka";
+/// The launcher's name: the menu, the install folder and the shortcuts.
+pub const LAUNCHER_NAME: &str = "Honoka Launcher";
+/// The window's application id (Linux desktops group windows by it).
+pub const APP_ID: &str = "honoka-launcher";
+/// The launcher's own data folder, in the platform's data directory. Apart from Horizon's
+/// (`horizon-launcher`), so Honoka and Horizon can be installed side by side.
+pub const DATA_DIR: &str = "honoka-launcher";
+/// The game's folder (saves, options.txt, instances), apart from Horizon's (`horizon`).
+pub const GAME_DIR: &str = "honoka";
+/// Where the location pointer of a moved data folder is kept (`location.json`).
+pub const LOCATION_DIR: &str = "honoka-launcher-location";
+
+/// The server Play joins, and its name in the game's server list.
+pub const SERVER_NAME: &str = "Hoka";
+pub const SERVER_ADDRESS: &str = "mc.hoka.ink";
+
+/// The links (website, Discord, the server's address) read at start, so they change without a
+/// release. Until it is read, or when it can't be, the built-in ones below are used.
+pub const LINKS_URL: &str =
+    "https://raw.githubusercontent.com/tearsmilk/minecraft-python/main/branding/links.json";
+pub const WEBSITE: &str = "https://hoka.ink";
+/// Empty hides the button.
+pub const DISCORD: &str = "";
+pub const SPONSOR: &str = "";
+
+/// The server runs an older version than the game (1.21.11 behind Velocity): Horizon's adapter
+/// for older servers is on for every game Honoka starts. The server's status ping picks the
+/// adapter, and a 26.3 server is played as before.
+pub const OLDER_SERVERS_ENV: (&str, &str) = ("HORIZON_OLDER_SERVERS", "1");
+
+/// Self-update stays off until Honoka publishes its own signed launcher releases: Horizon's
+/// would replace this launcher with Horizon's.
+pub const SELF_UPDATE: bool = false;
